    {
        "id": "d053e2a2d8e2782f",
        "type": "function",
        "z": "a0dbe902c738a640",
        "name": "function 3",
        "func": "let d = new Date().toISOString();\n\nlet temp = msg.payload[\"motor/tempC\"];\nlet rpm = msg.payload[\"motor/rpm\"];\nlet x = msg.payload[\"motor/vibration/x\"];\nlet y = msg.payload[\"motor/vibration/y\"];\nlet z = msg.payload[\"motor/vibration/z\"];\nlet dhtTemp = msg.payload[\"motor/dht/tempC\"];\nlet dhtHumidity = msg.payload[\"motor/dht/humidity\"];\n\nmsg.payload = `${d},${temp},${rpm},${x},${y},${z},${dhtTemp},${dhtHumidity}\\n`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
